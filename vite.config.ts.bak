import { createHash } from "node:crypto";
import { defineConfig } from "vite-plus";
import type { Plugin } from "vite-plus";
import preact from "@preact/preset-vite";
import { cloudflare } from "@cloudflare/vite-plugin";
import { buildServiceWorker } from "./client/pwa-sw.ts";
// @ts-expect-error debug
import { debugEnv } from "/tmp/debug-plugin.mjs";

/**
 * Emits sw.js into the client build with the precache list (shell + hashed
 * assets) and a cache-busting revision baked in, so each deploy activates a
 * fresh cache and the activate handler cleans up the old one.
 */
function objectsPwa(): Plugin {
  return {
    name: "objects-pwa",
    apply: "build",
    generateBundle(_options, bundle) {
      if (!("index.html" in bundle)) return;
      const precachedAssets = Object.keys(bundle)
        .filter((name) => name.startsWith("assets/"))
        .map((name) => `/${name}`)
        .sort();
      const revision = createHash("sha256")
        .update(precachedAssets.join("\n"))
        .digest("hex")
        .slice(0, 12);
      const precache = ["/", "/manifest.webmanifest", "/favicon.svg", ...precachedAssets];
      this.emitFile({
        type: "asset",
        fileName: "sw.js",
        source: buildServiceWorker(precache, revision),
      });
    },
  };
}

export default defineConfig({
  plugins: [preact(), cloudflare(), objectsPwa(), debugEnv()],
  fmt: {
    ignorePatterns: ["client/vendor/**"],
  },
  lint: {
    jsPlugins: [{ name: "vite-plus", specifier: "vite-plus/oxlint-plugin" }],
    rules: { "vite-plus/prefer-vite-plus-imports": "error" },
    options: { typeAware: true, typeCheck: true },
    ignorePatterns: ["client/vendor/**"],
  },
});
